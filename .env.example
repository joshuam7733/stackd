# STACKD server configuration. Copy to `.env` and fill in what you need. Never commit `.env`.
# Every variable is optional for local development: with none set, STACKD runs in DEMO MODE on
# http://localhost:5173 with a SQLite database in ./data/stackd.db.

# ---- Server ---------------------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1                      # 0.0.0.0 to accept connections from other devices / containers
PORT=5173
PUBLIC_URL=http://localhost:5173    # the URL people open; used for OAuth redirects and cookie security
TRUST_PROXY=false                   # true behind a reverse proxy / load balancer (uses X-Forwarded-For)
COOKIE_SECURE=                      # defaults to true when PUBLIC_URL starts with https://

# ---- Database -------------------------------------------------------------------------------------
# SQLite file (relative paths resolve from the project root). See README → "Moving to Postgres".
DATABASE_URL=sqlite:./data/stackd.db

# ---- Demo mode ------------------------------------------------------------------------------------
DEMO_MODE=true                      # demo money only; real payments stay off regardless (see Payments)
DEMO_LOGINS=true                    # one-tap demo player/admin/sponsor buttons. Set false on any shared deployment.
WORLD_CLOCK=true                    # demo players, lobby timers, simulated matches, provider callbacks
WORLD_TICK_MS=2500
SIM_COUNTDOWN_MS=15000              # battle royale lobby countdown (simulation adapter)
SIM_MATCH_MS=90000                  # simulated battle royale length

# ---- Authentication: Google OAuth (OpenID Connect) -------------------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials (type: Web application)
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback  e.g. http://localhost:5173/auth/google/callback
# Leave blank to keep Google sign-in switched off (email + password keeps working).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=                # optional override; defaults to <PUBLIC_URL>/auth/google/callback

# ---- Future sign-in providers (not implemented yet) ------------------------------------------------
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# SMS_PROVIDER_API_KEY=             # phone-number sign-in (OTP)

# ---- Email / SMS notifications (not implemented yet; notifications are in-app today) --------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="STACKD <no-reply@example.com>"

